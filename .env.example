# Firebase client config for HyperCBT in the "Quality Tools" project
# (quality-toolsx). Find these under Firebase console > Project settings >
# General > Your apps > HyperCBT. Not secret, but .env stays out of git.
# Copy this file to .env and fill in real values.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=quality-toolsx.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=quality-toolsx
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# App Check (spam protection) - the reCAPTCHA Enterprise *key ID* for
# hypercbt-qt.web.app. App Check is enforced on quality-toolsx, so the real
# project won't answer without it.
VITE_RECAPTCHA_SITE_KEY=
# Only for running against the real project from localhost: a debug token
# registered in Firebase console > App Check > Apps > HyperCBT > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=

# Google One Tap: the project's OAuth web client ID (the same one PeraForm
# uses), with https://hypercbt-qt.web.app added to its JavaScript origins.
VITE_GOOGLE_OAUTH_CLIENT_ID=
