rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnUserDoc(email) {
      return isSignedIn() && request.auth.token.email == email;
    }

    // Test makers need a verified email (decided 2026-10-29, same rule as
    // PeraForm): ownership is by email, so an unverified password account
    // mustn't be able to act as an address it hasn't proven. Google and
    // email-link sign-ins are verified already. Candidates sitting a test
    // don't need it.
    function isMaker() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    // Ownership replaces the old fixed admin allowlist: whoever created a
    // test is the only one who can manage it. createdBy is set once at
    // creation (see createTest in src/services/firestore.js) and never
    // changes. Only used for single-document checks (get/update/delete on
    // one test, or the answerKey subdoc) - never inside a list/collectionGroup
    // rule, where a get() per candidate document isn't how Firestore proves
    // a query is safe to run (see the testOwnerEmail comment below).
    function isTestOwner(testId) {
      return isMaker() &&
        get(/databases/$(database)/documents/tests/$(testId)).data.createdBy == request.auth.token.email;
    }

    // Test metadata + questions (answer-free - see the answerKey subcollection
    // below). Any signed-in user can open a test via its shared link; only the
    // owner can create/edit/delete it, and only the owner can list their own
    // tests (the query behind listTests()/TestsList always adds a matching
    // where('createdBy', ...) clause, which is what lets Firestore prove this
    // rule holds for every document in that result set).
    // Owner of the test as it will stand once the current write (or batch)
    // commits - getAfter() sees sibling writes in the same batch, so this
    // works both for createTest()'s batch (parent created alongside) and for
    // later standalone writes. Used to gate the owner-only subdocs' writes.
    function willOwnTest(testId) {
      return isMaker() &&
        getAfter(/databases/$(database)/documents/tests/$(testId)).data.createdBy == request.auth.token.email;
    }

    match /tests/{testId} {
      allow get: if isSignedIn();
      allow list: if isMaker() && resource.data.createdBy == request.auth.token.email;
      // The roster must never sit on this publicly-readable doc - it lives in
      // the owner-only roster subcollection below.
      allow create: if isMaker() &&
        request.resource.data.createdBy == request.auth.token.email &&
        request.resource.data.status == 'draft' &&
        !('allowedUsers' in request.resource.data);
      // createdBy is fixed at creation: an owner can't hand a test (and its
      // submissions) to another account.
      allow update: if isTestOwner(testId) &&
        request.resource.data.createdBy == resource.data.createdBy &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['allowedUsers']);
      allow delete: if isTestOwner(testId);

      // tests/{testId}/answerKey/data - the correct answers, index-aligned
      // with tests/{testId}.questions. Owner-only: this is the whole point of
      // splitting it out of the test doc - a test-taker's client must never
      // be able to read it. Cloud Functions grade via the Admin SDK, which
      // bypasses these rules entirely.
      //
      // Writes check the parent's owner via getAfter() (willOwnTest), so
      // nobody can plant an answer key on someone else's test, while
      // createTest() can still write it in the same batch as the parent.
      match /answerKey/{doc} {
        allow read, delete: if isTestOwner(testId);
        allow create, update: if willOwnTest(testId);
      }

      // tests/{testId}/roster/data - the approved name + Student ID list.
      // Owner-only for the same reason as the answer key: if test-takers
      // could read it they could start the test as a classmate. The
      // startTest Cloud Function checks it via the Admin SDK.
      match /roster/{doc} {
        allow read, delete: if isTestOwner(testId);
        allow create, update: if willOwnTest(testId);
      }

      // tests/{testId}/submissions/{studentId} - one doc per test-taker,
      // keyed by their (normalized) Student ID.
      //
      // testOwnerEmail is a denormalized copy of the parent test's createdBy
      // so owner-scoped list queries (listSubmissionsForTest, the
      // dashboard's listRecentSubmissions) stay proveable: Firestore can
      // only skip evaluating a list rule against every document in the
      // database when the query's own where() clause matches the rule's
      // condition on a plain field - a get() inside the rule can't be
      // matched to a query filter that way.
      match /submissions/{submissionId} {
        // A candidate reads their own; the test's (verified) owner reads all.
        allow read: if isSignedIn() &&
          (resource.data.userEmail == request.auth.token.email ||
           (isMaker() && resource.data.testOwnerEmail == request.auth.token.email));

        // Starting an attempt (roster check + dedupe), finalizing it
        // (grading), and deleting it all go through Cloud Functions
        // (startTest / submitTest / deleteSubmission) using the Admin SDK,
        // which bypasses these rules entirely - none of those operations
        // can be trusted to a direct client write, so there's nothing left
        // for a client to legitimately do here directly.
        allow write: if false;
      }
    }

    // Collection-group access for the dashboard's cross-test recent-
    // submissions query. Fixed-path rules above don't apply to
    // collectionGroup() queries - Firestore only honors {path=**} wildcard
    // rules for those. Same testOwnerEmail field, same reasoning as above:
    // listRecentSubmissions() always adds a matching where('testOwnerEmail', ...).
    match /{path=**}/submissions/{submissionId} {
      allow read: if isMaker() && resource.data.testOwnerEmail == request.auth.token.email;
    }

    // users/{email} - doc id is the signed-in user's email, per spec.
    // testsTaken is written only by the submitTest/deleteSubmission Cloud
    // Functions - a user clearing their own flag would re-open the start
    // screen for a second attempt under a different Student ID.
    match /users/{email} {
      allow read: if isOwnUserDoc(email);
      allow create: if isOwnUserDoc(email) && !('testsTaken' in request.resource.data);
      allow update: if isOwnUserDoc(email) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['testsTaken']);
      allow delete: if false;

      // This person's own stars and folders for their tests (lib/organize.js):
      //   users/{email}/testMeta/{testId}, users/{email}/folders/{folderId}
      match /testMeta/{testId} {
        allow read, write: if isOwnUserDoc(email) && isMaker();
      }
      match /folders/{folderId} {
        allow read, write: if isOwnUserDoc(email) && isMaker();
      }
      // Recently used templates, synced across devices (dashboard).
      match /settings/{settingId} {
        allow read, write: if isOwnUserDoc(email) && isMaker();
      }
    }
  }
}
